# ─── Band / Thenvoi platform ──────────────────────────────────────────────
# User API key (NOT an agent key). Only needed for the automation scripts:
#   setup_agents.py  (bulk-create the 3 agents)
#   kickoff.py       (create the room + post the intake signal)
# Get it from app.band.ai (or app.thenvoi.com) -> Settings -> REST API Keys.
THENVOI_API_KEY_USER=
# Override only for self-hosted Band. Default is Band Cloud (app.thenvoi.com).
# THENVOI_PLATFORM_URL=https://app.thenvoi.com

# ─── Model providers (the cross-provider cast) ────────────────────────────
# Clinical Reviewer       -> Anthropic API (Claude Sonnet 4.5)   [required]
ANTHROPIC_API_KEY=
# Safety Verifier (DEFAULT) -> Groq (Llama 3.3 70B, free tier).  console.groq.com
# A free signup (no card) unlocks the genuinely cross-provider board: a Llama
# challenger checking the Claude assessment. If this is left blank, the Verifier
# automatically falls back to the local Claude SDK so the demo still runs.
GROQ_API_KEY=
# Safety Verifier (alt)   -> Featherless (open models).  Hackathon promo: BOA26
FEATHERLESS_API_KEY=
# Regulatory & Compliance partner option -> AI/ML API.   Claim coupon via lablab.ai
AIMLAPI_KEY=

# ─── Demo controls ────────────────────────────────────────────────────────
# DSR_LIVE=0  -> deterministic frozen FDA case (recommended for a recorded demo)
# DSR_LIVE=1  -> live openFDA signal (default)
# DSR_LIVE=1
# DSR_CASE selects the scenario: amiodarone_warfarin (default) | benign_lot | qt_droperidol
#   benign_lot is the control case the board should NOT escalate.
# DSR_CASE=amiodarone_warfarin
# USE_LIVE_TOOLS=1 attaches live openFDA + PubMed tools to the Clinical Reviewer
# AND the Safety Verifier (on tuple-tool frameworks) so they can pull evidence
# mid-deliberation and source the re-derivation.
# USE_LIVE_TOOLS=1
