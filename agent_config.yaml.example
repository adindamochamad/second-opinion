# Generated by `python setup_agents.py`. You can also create the 3 agents in the
# Band web UI (app.band.ai -> create remote agent) and paste the credentials here.
# One block per agent config_key. Keep this file out of git (see .gitignore) —
# the api_key values are live agent secrets.
#
# Rename to: agent_config.drug_safety_review.yaml
clinical_reviewer:
  agent_id: paste-clinical-reviewer-uuid
  api_key: paste-clinical-reviewer-api-key
safety_verifier:
  agent_id: paste-safety-verifier-uuid
  api_key: paste-safety-verifier-api-key
regulatory_compliance:
  agent_id: paste-regulatory-compliance-uuid
  api_key: paste-regulatory-compliance-api-key
